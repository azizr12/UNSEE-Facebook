{
  "manifest_version": 3,
  "name": "Unseen for Facebook (Clean)",
  "description": "Blocks Seen, Typing, and Stories Seen receipts. Zero bloat.",
  "version": "1.0.2",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://web.facebook.com/*",
    "https://www.messenger.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*",
        "https://web.facebook.com/*",
        "https://www.messenger.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
